@EndUserText.label : 'Gestion commerciale - Product drafts'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zgc_rap_prod_d {
  key client              : abap.clnt not null;
  key productuuid         : sysuuid_x16 not null;
  productcode             : abap.char(30);
  productname             : abap.char(200);
  @Semantics.amount.currencyCode : 'zgc_rap_prod_d.currencycode'
  unitprice               : abap.curr(15,2);
  currencycode            : abap.cuky;
  status                  : abap.char(8);
  createdby               : abp_creation_user;
  createdat               : abp_creation_tstmpl;
  lastchangedby           : abp_locinst_lastchange_user;
  lastchangedat           : abp_lastchange_tstmpl;
  locallastchangedat       : abp_locinst_lastchange_tstmpl;
  "%admin"                : include sych_bdl_draft_admin_inc;
}