            <Trigger Name="WHEN-BUTTON-PRESSED" DirtyInfo="true" TriggerText="GO_BLOCK('CUSTOMER');&amp;#10;IF :CUSTOMER.CUSTOMER_ID IS NULL THEN&amp;#10;  MESSAGE('Customer was not found.');&amp;#10;  RAISE FORM_TRIGGER_FAILURE;&amp;#10;END IF;&amp;#10;DELETE_RECORD;&amp;#10;COMMIT_FORM;"/>
