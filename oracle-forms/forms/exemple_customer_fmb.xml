         <Trigger Name="PRE-INSERT" DirtyInfo="true" TriggerText="DECLARE&amp;#10;  duplicate_count NUMBER;&amp;#10;BEGIN&amp;#10;  SELECT COUNT(*) INTO duplicate_count FROM CUSTOMER&amp;#10;   WHERE CUSTOMER_ID = :CUSTOMER.CUSTOMER_ID&amp;#10;      OR EMAIL = :CUSTOMER.EMAIL;&amp;#10;&amp;#10;  IF duplicate_count &gt; 0 THEN&amp;#10;    MESSAGE('Customer ID or email must be unique.');&amp;#10;    RAISE FORM_TRIGGER_FAILURE;&amp;#10;  END IF;&amp;#10;END;"/>
         <Trigger Name="WHEN-NEW-RECORD-INSTANCE" DirtyInfo="true" TriggerText="IF :SYSTEM.RECORD_STATUS = 'NEW' THEN&amp;#10;  :CUSTOMER.ACTIVE := 'Y';&amp;#10;  SET_ITEM_PROPERTY('CUSTOMER.CUSTOMER_ID', UPDATE_ALLOWED, PROPERTY_TRUE);&amp;#10;ELSE&amp;#10;  SET_ITEM_PROPERTY('CUSTOMER.CUSTOMER_ID', UPDATE_ALLOWED, PROPERTY_FALSE);&amp;#10;END IF;"/>
