            <Trigger Name="WHEN-VALIDATE-ITEM" DirtyInfo="true" TriggerText="IF :CUSTOMER.EMAIL IS NULL OR TRIM(:CUSTOMER.EMAIL) IS NULL THEN&amp;#10;  MESSAGE('Email is mandatory.');&amp;#10;  RAISE FORM_TRIGGER_FAILURE;&amp;#10;END IF;&amp;#10;&amp;#10;IF NOT REGEXP_LIKE(:CUSTOMER.EMAIL, '^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$') THEN&amp;#10;  MESSAGE('Email format is invalid.');&amp;#10;  RAISE FORM_TRIGGER_FAILURE;&amp;#10;END IF;"/>
