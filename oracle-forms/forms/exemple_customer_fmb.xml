         <Item Name="NAME" Prompt="Name" TabPageName="" PromptAttachmentOffset="9" DistanceBetweenRecords="96" Width="549" MaximumLength="100" ItemType="Text Item" XPosition="76" Required="true" YPosition="49" DirtyInfo="true" CanvasName="CUSTOMER_CANVAS" ColumnName="NAME" PromptDisplayStyle="All Records" DataLengthSemantics="BYTE" ItemsDisplay="0" Height="16">
            <Trigger Name="WHEN-VALIDATE-ITEM" DirtyInfo="true" TriggerText="IF :CUSTOMER.NAME IS NULL OR TRIM(:CUSTOMER.NAME) IS NULL THEN&amp;#10;  MESSAGE('Name is mandatory.');&amp;#10;  RAISE FORM_TRIGGER_FAILURE;&amp;#10;END IF;"/>
